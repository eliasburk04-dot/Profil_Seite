// Static Next.js export served as Workers static assets (no server code).
// _headers and _redirects in public/ are applied by the asset handler.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "burk-solutions",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
